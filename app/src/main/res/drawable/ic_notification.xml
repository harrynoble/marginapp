<?xml version="1.0" encoding="utf-8"?>
<!--
    Status bar icons must be a flat silhouette, and the full wordmark is unreadable at 24dp,
    so the notification icon is the wordmark's first letter and its full stop: "m.".
    Same geometry as ic_launcher_foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <group
        android:translateX="2"
        android:translateY="0.89"
        android:scaleX="0.2778"
        android:scaleY="0.2778">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="9.5"
            android:strokeLineCap="butt"
            android:strokeLineJoin="round"
            android:pathData="M4.5,60 V20
                M4.5,36 A11.5,11.5 0 0 1 27.5,36 V60
                M27.5,36 A11.5,11.5 0 0 1 50.5,36 V60" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M60,54 a6,6 0 1 0 12,0 a6,6 0 1 0 -12,0 Z" />
    </group>
</vector>
